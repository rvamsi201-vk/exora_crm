# Runtime
NODE_ENV=development
PORT=3002
ALLOWED_ORIGINS=http://localhost:3002

# Required in production; use a unique random value of at least 32 characters.
JWT_SECRET=

# PostgreSQL: disable, require, or verify-full.
DATABASE_URL=
DATABASE_SSL_MODE=require

# Existing lead discovery integrations
SERPER_API_KEY=
N8N_QUERY=preschools in Bengaluru
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Development bootstrap only. Leave disabled for normal and production use.
AUTO_INIT_DB=true
SEED_DEFAULT_ADMIN=false
DEFAULT_ADMIN_NAME=
DEFAULT_ADMIN_EMAIL=
DEFAULT_ADMIN_PASSWORD=

# Background job worker (Phase 2+: campaign runs, enrichment, scoring, AI
# research). Runs in-process; disable only if running a separate worker.
ENABLE_JOB_WORKER=true

# Optional, provider-agnostic AI research (Phase 4). Leave both unset to
# disable — company research jobs will complete with status=skipped and no
# generated content rather than calling a paid API. Only "anthropic" is
# currently implemented (see lib/ai/provider.js); calls the vendor's API
# directly with axios, no extra SDK dependency.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Optional, provider-agnostic outreach (Phase 5). All sends are simulated
# (no network call, status='simulated') unless NODE_ENV=production AND the
# relevant provider below is configured — this is enforced in code, not
# just by leaving these blank. Only "sendgrid" (email) and "meta_cloud_api"
# (WhatsApp) are currently implemented; calling has no provider yet (see
# lib/outreach/calling.js) — a tel: click-to-dial link is always available.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=
WHATSAPP_PROVIDER=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
CALLING_PROVIDER=
CALLING_API_KEY=

# Shared secret for inbound delivery/reply events from whichever outreach
# provider is configured. Required in production; optional in dev, same
# pattern as N8N_WEBHOOK_SECRET above.
OUTREACH_WEBHOOK_SECRET=

# Hours after assignment before an opportunity's auto-created follow-up
# task is due (the Phase 5 SLA).
SLA_FIRST_CONTACT_HOURS=24
